# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Required. The shared passcode the business owner types in at /owner to
# see the list of bookings. Pick anything you like; it is not hashed
# anywhere else, so treat it like a real password.
OWNER_PASSCODE=change-me

# Optional overrides. Uncomment and edit only if you want different
# business hours / slot length / booking window than the defaults below.
# BUSINESS_START_HOUR=9
# BUSINESS_END_HOUR=17
# BUSINESS_DAYS=0,1,2,3,4
# SLOT_MINUTES=30
# BOOKING_WINDOW_DAYS=30

# Optional. Random secret used to sign the owner's session cookie. If not
# set, a random one is generated at startup (fine for local use, but means
# the owner is logged out every time the server restarts).
# SESSION_SECRET=some-random-string
